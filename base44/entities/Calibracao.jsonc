{
  "name": "Calibracao",
  "type": "object",
  "properties": {
    "equipamento": {
      "type": "string",
      "description": "Nome do equipamento"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "torquimetro",
        "apertadeira",
        "medicao",
        "eletronico",
        "outro"
      ],
      "description": "Categoria"
    },
    "marca": {
      "type": "string",
      "description": "Marca"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo"
    },
    "numero_serie": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie"
    },
    "certificado": {
      "type": "string",
      "description": "N\u00famero do certificado"
    },
    "calibracao_obrigatoria": {
      "type": "boolean",
      "default": true,
      "description": "Possui calibra\u00e7\u00e3o obrigat\u00f3ria"
    },
    "data_calibracao": {
      "type": "string",
      "format": "date",
      "description": "Data da \u00faltima calibra\u00e7\u00e3o"
    },
    "data_vencimento": {
      "type": "string",
      "format": "date",
      "description": "Data de vencimento"
    },
    "anexo_certificado": {
      "type": "string",
      "description": "URL do certificado"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel"
    },
    "celula": {
      "type": "string",
      "description": "C\u00e9lula"
    },
    "equipe": {
      "type": "string",
      "description": "Equipe"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "equipamento",
    "data_calibracao"
  ]
}