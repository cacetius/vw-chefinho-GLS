{
  "name": "LayoutLinha",
  "type": "object",
  "properties": {
    "nome_linha": {
      "type": "string",
      "description": "Nome da linha (ex: Linha Parachoque)"
    },
    "equipe": {
      "type": "string",
      "description": "Equipe respons\u00e1vel"
    },
    "turno": {
      "type": "string",
      "enum": [
        "manha",
        "tarde",
        "noite",
        "todos"
      ],
      "default": "todos"
    },
    "descricao": {
      "type": "string"
    },
    "grade_largura": {
      "type": "number",
      "default": 20
    },
    "grade_altura": {
      "type": "number",
      "default": 12
    },
    "elementos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "operacao",
              "armario",
              "bancada",
              "entrada",
              "saida",
              "lixeira",
              "ferramenta",
              "esteira",
              "qualidade",
              "texto"
            ]
          },
          "label": {
            "type": "string"
          },
          "x": {
            "type": "number"
          },
          "y": {
            "type": "number"
          },
          "largura": {
            "type": "number",
            "default": 2
          },
          "altura": {
            "type": "number",
            "default": 2
          },
          "cor": {
            "type": "string"
          },
          "observacao": {
            "type": "string"
          }
        }
      },
      "description": "Lista de elementos no layout"
    },
    "criado_por_nome": {
      "type": "string"
    }
  },
  "required": [
    "nome_linha",
    "equipe"
  ]
}