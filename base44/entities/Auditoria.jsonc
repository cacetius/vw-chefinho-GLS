      "type": "string"
    },
    "acao": {
      "type": "string",
      "enum": [
        "criacao",
        "edicao",
        "exclusao",
        "aprovacao",
        "reprovacao",
        "login",
        "logout"
      ],
      "description": "Tipo de a\u00e7\u00e3o"
    },
    "entidade_tipo": {
      "type": "string",
      "description": "Tipo de entidade afetada"
    },
    "entidade_id": {
      "type": "string",
      "description": "ID da entidade afetada"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o da a\u00e7\u00e3o"
    },
    "dados_anteriores": {
      "type": "object",
