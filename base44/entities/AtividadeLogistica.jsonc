{
  "name": "AtividadeLogistica",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da atividade"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada da atividade"
    },
    "responsavel": {
      "type": "string",
      "description": "Nome do respons\u00e1vel"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_andamento",
        "concluida",
        "cancelada"
      ],
      "default": "pendente"
    },
    "data_prevista": {
      "type": "string",
      "format": "date"
    },
    "setor": {
      "type": "string",
      "description": "Setor respons\u00e1vel pela atividade"
    }
  },
  "required": [
    "titulo",
    "responsavel"
  ]
}