{
  "name": "Feedback360",
  "type": "object",
  "properties": {
    "avaliado_id": {
      "type": "string",
      "description": "ID do colaborador avaliado"
    },
    "avaliado_nome": {
      "type": "string"
    },
    "avaliador_id": {
      "type": "string",
      "description": "ID do avaliador"
    },
    "avaliador_nome": {
      "type": "string"
    },
    "anonimo": {
      "type": "boolean",
      "default": false
    },
    "periodo": {
      "type": "string",
      "format": "date",
      "description": "M\u00eas/per\u00edodo de refer\u00eancia"
    },
    "criterios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "nota": {
            "type": "number",
            "minimum": 1,
            "maximum": 5
          },
          "comentario": {
            "type": "string"
          }
        }
      },
      "description": "Crit\u00e9rios de avalia\u00e7\u00e3o com notas"
    },
    "pontos_fortes": {
      "type": "string"
    },
    "pontos_melhoria": {
      "type": "string"
    },
    "comentario_geral": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "enviado",
        "visualizado"
      ],
      "default": "rascunho"
    }
  },
  "required": [
    "avaliado_id",
    "avaliado_nome",
    "criterios"
  ]
}