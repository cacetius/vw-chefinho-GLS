{
  "name": "EventoCalendario",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string"
    },
    "descricao": {
      "type": "string"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "tarefa",
        "treinamento",
        "ausencia",
        "manutencao",
        "reuniao",
        "outro"
      ],
      "description": "Tipo do evento"
    },
    "data_inicio": {
      "type": "string",
      "format": "date-time"
    },
    "data_fim": {
      "type": "string",
      "format": "date-time"
    },
    "participantes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos participantes"
    },
    "local": {
      "type": "string"
    },
    "cor": {
      "type": "string",
      "description": "Cor para visualiza\u00e7\u00e3o"
    },
    "lembrete": {
      "type": "number",
      "description": "Minutos antes para lembrete"
    },
    "criado_por": {
      "type": "string"
    },
    "entidade_relacionada_tipo": {
      "type": "string"
    },
    "entidade_relacionada_id": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "tipo",
    "data_inicio",
    "data_fim"
  ]
}