{
  "name": "Ferramenta",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da ferramenta"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo identificador"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "maquina",
        "ferramenta",
        "torque",
        "equipamento",
        "instrumento_medicao",
        "dispositivo",
        "gabarito"
      ],
      "description": "Categoria da ferramenta"
    },
    "marca": {
      "type": "string",
      "description": "Marca"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo"
    },
    "numero_serie": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie"
    },
    "patrimonio": {
      "type": "string",
      "description": "N\u00famero de patrim\u00f4nio"
    },
    "area": {
      "type": "string",
      "description": "\u00c1rea"
    },
    "celula": {
      "type": "string",
      "description": "C\u00e9lula"
    },
    "equipe": {
      "type": "string",
      "description": "Equipe"
    },
    "monitor_responsavel": {
      "type": "string",
      "description": "Monitor respons\u00e1vel"
    },
    "lider_responsavel": {
      "type": "string",
      "description": "L\u00edder respons\u00e1vel"
    },
    "localizacao": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o f\u00edsica"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "em_manutencao",
        "em_calibracao",
        "fora_de_uso"
      ],
      "default": "ativo",
      "description": "Status da ferramenta"
    },
    "foto": {
      "type": "string",
      "description": "URL da foto"
    },
    "etiqueta_data_instalacao": {
      "type": "string",
      "format": "date",
      "description": "Data de instala\u00e7\u00e3o da etiqueta"
    },
    "etiqueta_ultima_revisao": {
      "type": "string",
      "format": "date",
      "description": "\u00daltima revis\u00e3o da etiqueta"
    },
    "etiqueta_status": {
      "type": "string",
      "enum": [
        "ok",
        "desgastada",
        "substituir"
      ],
      "default": "ok",
      "description": "Estado da etiqueta"
    },
    "etiqueta_legivel": {
      "type": "boolean",
      "default": true,
      "description": "Etiqueta est\u00e1 leg\u00edvel"
    },
    "etiqueta_fixada": {
      "type": "boolean",
      "default": true,
      "description": "Etiqueta est\u00e1 bem fixada"
    },
    "etiqueta_atualizada": {
      "type": "boolean",
      "default": true,
      "description": "Etiqueta est\u00e1 com dados atualizados"
    },
    "certificado_calibracao": {
      "type": "string",
      "description": "N\u00famero do certificado de calibra\u00e7\u00e3o"
    },
    "data_ultima_calibracao": {
      "type": "string",
      "format": "date",
      "description": "Data da \u00faltima calibra\u00e7\u00e3o"
    },
    "data_vencimento_calibracao": {
      "type": "string",
      "format": "date",
      "description": "Vencimento da calibra\u00e7\u00e3o"
    },
    "anexo_certificado": {
      "type": "string",
      "description": "URL do anexo do certificado"
    },
    "calibracao_obrigatoria": {
      "type": "boolean",
      "default": false,
      "description": "Possui calibra\u00e7\u00e3o obrigat\u00f3ria"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "nome",
    "categoria"
  ]
}