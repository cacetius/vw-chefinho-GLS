{
  "name": "Ferramenta",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da ferramenta"
    },
    "codigo": {
      "type": "string",
      "description": "C\u00f3digo identificador"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "maquina",
        "ferramenta",
        "torque",
        "equipamento",
        "instrumento_medicao",
        "dispositivo",
        "gabarito"
      ],
      "description": "Categoria da ferramenta"
    },
    "marca": {
      "type": "string",
      "description": "Marca"
    },
    "modelo": {
      "type": "string",
      "description": "Modelo"
    },
    "numero_serie": {
      "type": "string",
      "description": "N\u00famero de s\u00e9rie"
    },
    "patrimonio": {
      "type": "string",
      "description": "N\u00famero de patrim\u00f4nio"
    },
    "area": {
      "type": "string",
      "description": "\u00c1rea"
    },
    "celula": {
      "type": "string",
      "description": "C\u00e9lula"
    },
    "equipe": {
      "type": "string",
      "description": "Equipe"
    },
    "monitor_responsavel": {
      "type": "string",
      "description": "Monitor respons\u00e1vel"
    },
    "lider_responsavel": {
      "type": "string",
      "description": "L\u00edder respons\u00e1vel"
    },
    "localizacao": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o f\u00edsica"
    },
    "status": {
      "type": "string",
      "enum": [
        "ativo",
        "em_manutencao",
        "em_calibracao",
        "fora_de_uso"
      ],
      "default": "ativo",
      "description": "Status da ferramenta"
    },
    "foto": {
      "type": "string",
      "description": "URL da foto"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    }
  },
  "required": [
    "nome",
    "categoria"
  ]
}