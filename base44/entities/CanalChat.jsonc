{
  "name": "CanalChat",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do canal"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do canal"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "geral",
        "equipe",
        "turno",
        "projeto"
      ],
      "default": "geral"
    },
    "equipe": {
      "type": "string",
      "description": "Equipe associada ao canal"
    },
    "turno": {
      "type": "string",
      "enum": [
        "manha",
        "tarde",
        "noite",
        "todos"
      ],
      "description": "Turno associado"
    },
    "membros": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "IDs dos membros do canal"
    },
    "privado": {
      "type": "boolean",
      "default": false,
      "description": "Se o canal \u00e9 privado"
    },
    "criado_por": {
      "type": "string",
      "description": "ID do criador"
    }
  },
  "required": [
    "nome",
    "tipo"
  ]
}