{
  "name": "PedidoEPI",
  "type": "object",
  "properties": {
    "solicitante": {
      "type": "string",
      "description": "Nome do solicitante"
    },
    "solicitante_id": {
      "type": "string",
      "description": "ID do solicitante"
    },
    "solicitante_full_name": {
      "type": "string",
      "description": "Nome completo do solicitante (do sistema)"
    },
    "equipe": {
      "type": "string",
      "description": "Equipe do solicitante"
    },
    "celula": {
      "type": "string",
      "description": "C\u00e9lula do solicitante"
    },
    "turno": {
      "type": "string",
      "description": "Turno do solicitante"
    },
    "item": {
      "type": "string",
      "description": "Item de EPI solicitado"
    },
    "quantidade": {
      "type": "number",
      "description": "Quantidade solicitada"
    },
    "justificativa": {
      "type": "string",
      "description": "Justificativa do pedido"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "aprovado",
        "reprovado",
        "entregue"
      ],
      "default": "pendente"
    },
    "urgencia": {
      "type": "string",
      "enum": [
        "normal",
        "urgente"
      ],
      "default": "normal"
    },
    "data_solicitacao": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "solicitante",
    "item",
    "quantidade"
  ]
}