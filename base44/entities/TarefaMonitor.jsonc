{
  "name": "TarefaMonitor",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da tarefa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "responsavel": {
      "type": "string",
      "description": "Nome do respons\u00e1vel"
    },
    "monitor_atribuido": {
      "type": "string",
      "description": "ID do monitor espec\u00edfico atribu\u00eddo \u00e0 tarefa"
    },
    "prioridade": {
      "type": "string",
      "enum": [
        "baixa",
        "media",
        "alta",
        "urgente"
      ],
      "default": "media"
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_andamento",
        "concluida"
      ],
      "default": "pendente"
    },
    "data_limite": {
      "type": "string",
      "format": "date"
    },
    "tipo_area": {
      "type": "string",
      "enum": [
        "monitor",
        "lider"
      ],
      "description": "\u00c1rea da tarefa"
    }
  },
  "required": [
    "titulo",
    "responsavel",
    "tipo_area"
  ]
}