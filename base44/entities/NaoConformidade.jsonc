{
  "name": "NaoConformidade",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da n\u00e3o conformidade"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada do problema"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "ferramenta",
        "etiqueta",
        "calibracao",
        "5s",
        "seguranca",
        "equipamento",
        "processo",
        "bancada",
        "outro"
      ],
      "description": "Categoria da NC"
    },
    "severidade": {
      "type": "string",
      "enum": [
        "critica",
        "maior",
        "menor"
      ],
      "default": "menor",
      "description": "N\u00edvel de severidade"
    },
    "status": {
      "type": "string",
      "enum": [
        "aberta",
        "em_andamento",
        "pendente_verificacao",
        "encerrada"
      ],
      "default": "aberta",
      "description": "Status atual"
    },
    "area": {
      "type": "string",
      "description": "\u00c1rea onde ocorreu"
    },
    "celula": {
      "type": "string",
      "description": "C\u00e9lula"
    },
    "tacto": {
      "type": "string",
      "description": "Tacto/setor"
    },
    "localizacao_detalhe": {
      "type": "string",
      "description": "Detalhe da localiza\u00e7\u00e3o"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel pela resolu\u00e7\u00e3o"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do respons\u00e1vel"
    },
    "registrado_por": {
      "type": "string",
      "description": "Quem registrou"
    },
    "registrado_por_id": {
      "type": "string",
      "description": "ID de quem registrou"
    },
    "ferramenta_id": {
      "type": "string",
      "description": "ID da ferramenta relacionada (se houver)"
    },
    "ferramenta_nome": {
      "type": "string",
      "description": "Nome da ferramenta relacionada"
    },
    "auditoria_id": {
      "type": "string",
      "description": "ID da auditoria de origem"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das fotos de evid\u00eancia"
    },
    "prazo": {
      "type": "string",
      "format": "date",
      "description": "Prazo para resolu\u00e7\u00e3o"
    },
    "acao_corretiva": {
      "type": "string",
      "description": "A\u00e7\u00e3o corretiva definida"
    },
    "data_encerramento": {
      "type": "string",
      "format": "date",
      "description": "Data de encerramento"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es adicionais"
    }
  },
  "required": [
    "titulo",
    "categoria",
    "area"
  ]
}