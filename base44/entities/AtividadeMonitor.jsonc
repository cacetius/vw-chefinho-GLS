{
  "name": "AtividadeMonitor",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da atividade"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "diaria",
        "semanal",
        "mensal",
        "personalizada"
      ],
      "description": "Frequ\u00eancia"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "verificar_ferramentas_criticas",
        "verificar_torques",
        "verificar_etiquetas",
        "verificar_faixas",
        "verificar_epi",
        "verificar_5s",
        "verificar_equipamentos",
        "auditoria_ferramentas",
        "auditoria_bancadas",
        "revisao_etiquetas",
        "revisao_faixas",
        "revisao_estoque_epi",
        "auditoria_completa",
        "inventario",
        "revisao_documental",
        "revisao_calibracoes",
        "revisao_equipamentos_criticos",
        "auditoria_rapida",
        "outro"
      ],
      "description": "Tipo"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da tarefa"
    },
    "prazo": {
      "type": "string",
      "format": "date",
      "description": "Prazo m\u00e1ximo"
    },
    "area": {
      "type": "string",
      "description": "\u00c1rea"
    },
    "celula": {
      "type": "string",
      "description": "C\u00e9lula"
    },
    "equipe": {
      "type": "string",
      "description": "Equipe"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel"
    },
    "criado_por": {
      "type": "string",
      "description": "Quem criou a tarefa"
    },
    "status": {
      "type": "string",
      "enum": [
        "nao_iniciado",
        "em_andamento",
        "concluido",
        "atrasado"
      ],
      "default": "nao_iniciado",
      "description": "Status"
    },
    "recorrencia": {
      "type": "string",
      "enum": [
        "nenhuma",
        "diaria",
        "semanal",
        "mensal"
      ],
      "default": "nenhuma",
      "description": "Recorr\u00eancia"
    },
    "origem_recorrencia": {
      "type": "string",
      "description": "ID da tarefa original (para tarefas recorrentes)"
    },
    "observacoes": {
      "type": "string",
      "description": "Observa\u00e7\u00f5es"
    },
    "foto": {
      "type": "string",
      "description": "URL da foto de evid\u00eancia"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs de fotos de evid\u00eancia"
    },
    "arquivos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      },
      "description": "Arquivos anexados"
    }
  },
  "required": [
    "titulo",
    "categoria",
    "data"
  ]
}