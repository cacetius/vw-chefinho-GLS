{
  "name": "AtividadeMonitor",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da atividade"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "diaria",
        "semanal",
        "mensal"
      ],
      "description": "Frequ\u00eancia da atividade"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "verificar_ferramentas_criticas",
        "verificar_torques",
        "verificar_etiquetas",
        "verificar_faixas",
        "verificar_epi",
        "verificar_5s",
        "verificar_equipamentos",
        "auditoria_ferramentas",
        "auditoria_bancadas",
        "revisao_etiquetas",
        "revisao_faixas",
        "revisao_estoque_epi",
        "auditoria_completa",
        "inventario",
        "revisao_documental",
        "revisao_calibracoes",
        "revisao_equipamentos_criticos",
        "auditoria_rapida",
        "outro"
      ],
      "description": "Tipo de atividade"
    },
    "data": {
      "type": "string",
      "format": "date"
    },
    "celula": {
      "type": "string"
    },
    "equipe": {
      "type": "string"
    },
    "responsavel": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "nao_iniciado",
        "em_andamento",
        "concluido",
        "atrasado"
      ],
      "default": "nao_iniciado"
    },
    "observacoes": {
      "type": "string"
    },
    "foto": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "categoria",
    "data"
  ]
}