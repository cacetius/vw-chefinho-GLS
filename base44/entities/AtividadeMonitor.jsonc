{
  "name": "AtividadeMonitor",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da tarefa"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "diaria",
        "semanal",
        "mensal",
        "personalizada"
      ],
      "description": "Frequ\u00eancia"
    },
    "recorrencia": {
      "type": "string",
      "enum": [
        "nenhuma",
        "todo_dia",
        "toda_semana",
        "todo_mes",
        "personalizada"
      ],
      "default": "nenhuma",
      "description": "Recorr\u00eancia autom\u00e1tica"
    },
    "data": {
      "type": "string",
      "format": "date",
      "description": "Data da tarefa"
    },
    "prazo": {
      "type": "string",
      "format": "date",
      "description": "Prazo final"
    },
    "area": {
      "type": "string",
      "description": "\u00c1rea"
    },
    "equipe": {
      "type": "string",
      "description": "Equipe"
    },
    "celula": {
      "type": "string",
      "description": "C\u00e9lula"
    },
    "responsavel": {
      "type": "string",
      "description": "Nome do respons\u00e1vel"
    },
    "responsavel_id": {
      "type": "string",
      "description": "ID do respons\u00e1vel"
    },
    "status": {
      "type": "string",
      "enum": [
        "nao_iniciado",
        "em_andamento",
        "concluido",
        "atrasado"
      ],
      "default": "nao_iniciado",
      "description": "Status"
    },
    "foto": {
      "type": "string",
      "description": "URL da foto de evid\u00eancia"
    },
    "observacao": {
      "type": "string",
      "description": "Observa\u00e7\u00e3o"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL de arquivo anexo"
    },
    "arquivo_nome": {
      "type": "string",
      "description": "Nome do arquivo"
    },
    "sugestao_ia": {
      "type": "string",
      "description": "Sugest\u00e3o gerada pela IA"
    },
    "criado_por": {
      "type": "string",
      "description": "Nome de quem criou"
    }
  },
  "required": [
    "titulo",
    "categoria",
    "data"
  ]
}