{
  "name": "PreferenciaUsuario",
  "type": "object",
  "properties": {
    "usuario_id": {
      "type": "string"
    },
    "tema": {
      "type": "string",
      "enum": [
        "claro",
        "escuro",
        "auto"
      ],
      "default": "claro"
    },
    "cor_primaria": {
      "type": "string",
      "description": "Cor prim\u00e1ria do tema"
    },
    "pagina_inicial": {
      "type": "string",
      "description": "P\u00e1gina padr\u00e3o ao fazer login"
    },
    "notificacoes_email": {
      "type": "boolean",
      "default": true
    },
    "notificacoes_push": {
      "type": "boolean",
      "default": true
    },
    "idioma": {
      "type": "string",
      "default": "pt-BR"
    },
    "widgets_dashboard": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "tipo": {
            "type": "string"
          },
          "posicao": {
            "type": "number"
          },
          "visivel": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "required": [
    "usuario_id"
  ]
}