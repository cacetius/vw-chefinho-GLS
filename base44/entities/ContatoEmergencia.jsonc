{
  "name": "ContatoEmergencia",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome do contato ou servi\u00e7o"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "bombeiros",
        "ambulatorio",
        "lider",
        "seguranca",
        "outro"
      ],
      "description": "Tipo de emerg\u00eancia"
    },
    "telefone": {
      "type": "string",
      "description": "N\u00famero de telefone"
    },
    "ramal": {
      "type": "string",
      "description": "Ramal interno"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o do servi\u00e7o"
    },
    "disponibilidade": {
      "type": "string",
      "description": "Hor\u00e1rio de disponibilidade"
    }
  },
  "required": [
    "nome",
    "tipo",
    "telefone"
  ]
}