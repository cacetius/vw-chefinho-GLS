{
  "name": "Treinamento",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do treinamento"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "habilidade_relacionada": {
      "type": "number",
      "description": "N\u00famero da habilidade da matriz"
    },
    "instrutor": {
      "type": "string",
      "description": "Nome do instrutor"
    },
    "instrutor_id": {
      "type": "string",
      "description": "ID do instrutor"
    },
    "participantes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "colaborador_id": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "inscrito",
              "em_andamento",
              "concluido",
              "reprovado"
            ]
          },
          "nota": {
            "type": "number"
          },
          "data_conclusao": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "data_inicio": {
      "type": "string",
      "format": "date"
    },
    "data_fim": {
      "type": "string",
      "format": "date"
    },
    "carga_horaria": {
      "type": "number",
      "description": "Horas de dura\u00e7\u00e3o"
    },
    "local": {
      "type": "string",
      "description": "Local do treinamento"
    },
    "materiais": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          }
        }
      },
      "description": "Materiais de apoio"
    },
    "status": {
      "type": "string",
      "enum": [
        "planejado",
        "em_andamento",
        "concluido",
        "cancelado"
      ],
      "default": "planejado"
    }
  },
  "required": [
    "titulo",
    "instrutor",
    "data_inicio"
  ]
}