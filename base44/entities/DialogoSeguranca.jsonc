{
  "name": "DialogoSeguranca",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo do di\u00e1logo"
    },
    "tipo": {
      "type": "string",
      "enum": [
        "dds",
        "reuniao_seguranca",
        "treinamento",
        "procedimento",
        "outro"
      ],
      "default": "dds",
      "description": "Tipo do di\u00e1logo"
    },
    "conteudo": {
      "type": "string",
      "description": "Conte\u00fado/texto do di\u00e1logo"
    },
    "arquivo_url": {
      "type": "string",
      "description": "URL do arquivo enviado"
    },
    "arquivo_nome": {
      "type": "string",
      "description": "Nome do arquivo"
    },
    "resumo_ia": {
      "type": "string",
      "description": "Resumo gerado pela IA"
    },
    "slides_ia": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "titulo": {
            "type": "string"
          },
          "texto": {
            "type": "string"
          },
          "emoji": {
            "type": "string"
          }
        }
      },
      "description": "Slides gerados pela IA para apresenta\u00e7\u00e3o"
    },
    "equipe": {
      "type": "string"
    },
    "turno": {
      "type": "string",
      "enum": [
        "manha",
        "tarde",
        "noite",
        "todos"
      ],
      "default": "todos"
    },
    "data_dialogo": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "rascunho",
        "processado",
        "apresentado"
      ],
      "default": "rascunho"
    },
    "autor": {
      "type": "string"
    }
  },
  "required": [
    "titulo",
    "tipo"
  ]
}