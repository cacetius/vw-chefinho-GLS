{
  "name": "EstoqueEPI",
  "type": "object",
  "properties": {
    "item": {
      "type": "string",
      "description": "Nome do item de EPI"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "protecao_cabeca",
        "protecao_olhos",
        "protecao_maos",
        "protecao_pes",
        "protecao_corpo",
        "outro"
      ],
      "description": "Categoria do EPI"
    },
    "quantidade_atual": {
      "type": "number",
      "description": "Quantidade dispon\u00edvel em estoque"
    },
    "quantidade_minima": {
      "type": "number",
      "description": "Estoque m\u00ednimo de seguran\u00e7a"
    },
    "unidade": {
      "type": "string",
      "description": "Unidade de medida (par, unidade, caixa)"
    },
    "localizacao": {
      "type": "string",
      "description": "Localiza\u00e7\u00e3o f\u00edsica no almoxarifado"
    },
    "fornecedor": {
      "type": "string",
      "description": "Fornecedor principal"
    },
    "preco_atual": {
      "type": "number",
      "description": "Pre\u00e7o unit\u00e1rio atual"
    },
    "historico_precos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "format": "date"
          },
          "preco": {
            "type": "number"
          },
          "fornecedor": {
            "type": "string"
          }
        }
      }
    },
    "ultima_reposicao": {
      "type": "string",
      "format": "date"
    },
    "validade": {
      "type": "string",
      "format": "date",
      "description": "Data de validade (se aplic\u00e1vel)"
    }
  },
  "required": [
    "item",
    "quantidade_atual",
    "quantidade_minima"
  ]
}