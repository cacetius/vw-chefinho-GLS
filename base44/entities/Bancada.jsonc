{
  "name": "Bancada",
  "type": "object",
  "properties": {
    "nome": {
      "type": "string",
      "description": "Nome da bancada"
    },
    "area": {
      "type": "string",
      "description": "\u00c1rea"
    },
    "celula": {
      "type": "string",
      "description": "C\u00e9lula"
    },
    "equipe": {
      "type": "string",
      "description": "Equipe"
    },
    "responsavel": {
      "type": "string",
      "description": "Respons\u00e1vel"
    },
    "plaquetas": {
      "type": "string",
      "description": "Plaquetas (descri\u00e7\u00e3o)"
    },
    "etiquetas": {
      "type": "string",
      "description": "Etiquetas (descri\u00e7\u00e3o)"
    },
    "faixas": {
      "type": "string",
      "description": "Faixas (descri\u00e7\u00e3o)"
    },
    "fotos": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "URLs das fotos"
    },
    "ultima_troca": {
      "type": "string",
      "format": "date",
      "description": "Data da \u00faltima troca"
    },
    "ultima_atualizacao": {
      "type": "string",
      "format": "date",
      "description": "Data da \u00faltima atualiza\u00e7\u00e3o"
    },
    "condicao_atual": {
      "type": "string",
      "enum": [
        "bom",
        "regular",
        "ruim",
        "critico"
      ],
      "default": "bom"
    },
    "tempo_uso": {
      "type": "number",
      "description": "Tempo de uso em dias"
    },
    "tempo_desgaste": {
      "type": "number",
      "description": "Tempo estimado de desgaste em dias"
    },
    "alerta_substituicao": {
      "type": "boolean",
      "default": false,
      "description": "Alerta de substitui\u00e7\u00e3o"
    },
    "observacoes": {
      "type": "string"
    }
  },
  "required": [
    "nome",
    "area"
  ]
}