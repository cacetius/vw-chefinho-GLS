{
  "name": "Sugestao",
  "type": "object",
  "properties": {
    "titulo": {
      "type": "string",
      "description": "T\u00edtulo da sugest\u00e3o"
    },
    "descricao": {
      "type": "string",
      "description": "Descri\u00e7\u00e3o detalhada"
    },
    "categoria": {
      "type": "string",
      "enum": [
        "processo",
        "seguranca",
        "qualidade",
        "ambiente",
        "custos",
        "outro"
      ],
      "description": "Categoria da sugest\u00e3o"
    },
    "autor_id": {
      "type": "string"
    },
    "autor_nome": {
      "type": "string"
    },
    "anexos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          }
        }
      }
    },
    "votos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "usuario_id": {
            "type": "string"
          },
          "tipo": {
            "type": "string",
            "enum": [
              "positivo",
              "negativo"
            ]
          }
        }
      }
    },
    "total_votos": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "pendente",
        "em_analise",
        "aprovada",
        "implementada",
        "rejeitada"
      ],
      "default": "pendente"
    },
    "resposta_lider": {
      "type": "string"
    },
    "data_implementacao": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "titulo",
    "descricao",
    "categoria",
    "autor_id",
    "autor_nome"
  ]
}